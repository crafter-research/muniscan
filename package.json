{
	"name": "muniscan",
	"version": "0.1.0",
	"description": "Automated, census-wide index of the digital surface declared by Peru's municipalities",
	"license": "MIT",
	"type": "module",
	"repository": {
		"type": "git",
		"url": "https://github.com/crafter-research/muniscan"
	},
	"scripts": {
		"dev": "astro dev",
		"build": "astro check && astro build",
		"check": "astro check && biome check src/web astro.config.mjs package.json biome.json",
		"preview": "astro preview",
		"scan": "bun run src/cli.ts scan",
		"score": "bun run src/cli.ts score",
		"diff": "bun run src/cli.ts diff",
		"health-sample": "bun run src/cli.ts health-sample",
		"test": "bun test",
		"typecheck": "tsc --noEmit"
	},
	"devDependencies": {
		"@astrojs/check": "^0.9.10",
		"@biomejs/biome": "^2.5.9",
		"@types/bun": "^1.3.14",
		"typescript": "^5.9.2"
	},
	"dependencies": {
		"@astrojs/vercel": "^11.0.7",
		"@tailwindcss/vite": "^4.3.3",
		"astro": "^7.2.4",
		"tailwindcss": "^4.3.3"
	}
}
