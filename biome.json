{
	"$schema": "https://biomejs.dev/schemas/2.5.9/schema.json",
	"formatter": {
		"indentStyle": "tab"
	},
	"overrides": [
		{
			"includes": ["src/web/**/*.astro"],
			"linter": {
				"rules": {
					"correctness": {
						"noUnusedImports": "off",
						"noUnusedVariables": "off"
					}
				}
			}
		},
		{
			"includes": ["src/web/**/*.css"],
			"linter": {
				"rules": {
					"style": {
						"noDescendingSpecificity": "off"
					}
				}
			}
		}
	]
}
